{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=messenger_db;Username=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_JWT_KEY_AT_LEAST_32_CHARACTERS",
